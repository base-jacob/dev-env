" =============================================================================
" Basics
" =============================================================================
set nocompatible
set background=dark
set number
set hidden
set ignorecase smartcase
set incsearch hlsearch
set tabstop=4 shiftwidth=4 expandtab
set mouse=a
set updatetime=300
set signcolumn=yes
set termguicolors
set splitbelow
syntax on
filetype plugin indent on
let mapleader=" "

" Use a colorscheme that doesn't fight with the terminal palette
silent! colorscheme lunaperche

" =============================================================================
" Plugins (vim-plug)
" =============================================================================
call plug#begin('~/.vim/plugged')
Plug 'yegappan/lsp'                                       " Native vim9 LSP client
Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
Plug 'junegunn/fzf.vim'
call plug#end()

" Termdebug ships with vim but is opt-in. Use packadd! to defer sourcing
" until vim has finished initializing — sourcing during vimrc executes the
" vim9script too early, breaking the :Termdebug -> StartDebug binding.
packadd! termdebug
let g:termdebug_config = {
      \   'command': 'arm-none-eabi-gdb',
      \   'winbar': 0,
      \ }

" Auto-close termdebug's program-I/O pane.
function! s:CloseTermdebugProgramWin() abort
  for winid in range(1, winnr('$'))
    let bufname = bufname(winbufnr(winid))
    if bufname =~? 'gdb.*program\|debugged-program'
      execute winid . 'close!'
      return
    endif
  endfor
endfunction
autocmd User TermdebugStartPost call s:CloseTermdebugProgramWin()

" =============================================================================
" LSP servers
" =============================================================================
" clangd for C / C++
autocmd User LspSetup call LspAddServer([#{
      \   name: 'clangd',
      \   filetype: ['c', 'cpp'],
      \   path: 'clangd',
      \   args: ['--background-index',
      \          '--header-insertion=never',
      \          '--clang-tidy',
      \          '--completion-style=detailed',
      \          '--pch-storage=memory',
      \          '--query-driver=**/arm-none-eabi-gcc,**/tiarmclang'],
      \ }])

" pyright for Python
autocmd User LspSetup call LspAddServer([#{
      \   name: 'pyright',
      \   filetype: ['python'],
      \   path: 'pyright-langserver',
      \   args: ['--stdio'],
      \ }])

autocmd User LspSetup call LspOptionsSet(#{
      \   autoComplete: v:true,
      \   autoHighlightDiags: v:false,
      \   showDiagInPopup: v:true,
      \   showDiagInBalloon: v:false,
      \   showDiagWithSign: v:true,
      \   showDiagWithVirtualText: v:false,
      \   highlightDiagInline: v:false,
      \   diagSignErrorText: 'E ',
      \   diagSignWarningText: 'W ',
      \   diagSignInfoText: 'I ',
      \   diagSignHintText: 'H ',
      \ })

" Navigation
nnoremap <silent> gd :LspGotoDefinition<CR>
nnoremap <silent> gr :LspShowReferences<CR>
nnoremap <silent> gy :LspGotoTypeDef<CR>
nnoremap <silent> gi :LspGotoImpl<CR>
nnoremap <silent> K  :LspHover<CR>

" Diagnostics
nnoremap <silent> [d :LspDiagPrev<CR>
nnoremap <silent> ]d :LspDiagNext<CR>
nnoremap <silent> <leader>e :LspDiagShow<CR>

" Symbol search
nnoremap <silent> <leader>s :LspDocumentSymbol<CR>
nnoremap <silent> <leader>S :LspSymbolSearch<Space>

" Refactor
nnoremap <silent> <leader>rn :LspRename<CR>
nnoremap <silent> <leader>ca :LspCodeAction<CR>

" =============================================================================
" fzf
" =============================================================================
nnoremap <silent> <leader>f :Files<CR>
nnoremap <silent> <leader>b :Buffers<CR>
nnoremap <silent> <leader>g :Rg<CR>
nnoremap <silent> <leader>l :BLines<CR>
nnoremap <silent> <leader>h :History<CR>

" fzf popup spans the bottom 40% of the window
let g:fzf_layout = { 'down': '~40%' }
