" =============================================================================
" Basics
" =============================================================================
set nocompatible
set background=dark
set number
set hidden
set ignorecase smartcase
set incsearch hlsearch
set tabstop=4 shiftwidth=4 expandtab
set mouse=a
set updatetime=300
set signcolumn=yes
set termguicolors
set splitbelow
syntax on
filetype plugin indent on
let mapleader=" "

" Use a colorscheme that doesn't fight with the terminal palette
silent! colorscheme lunaperche

" =============================================================================
" Plugins (vim-plug)
" =============================================================================
call plug#begin('~/.vim/plugged')
Plug 'yegappan/lsp'                                       " Native vim9 LSP client
Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
Plug 'junegunn/fzf.vim'
call plug#end()

" Termdebug ships with vim but is opt-in. Use packadd! to defer sourcing
" until vim has finished initializing — sourcing during vimrc executes the
" vim9script too early, breaking the :Termdebug -> StartDebug binding.
packadd! termdebug
let g:termdebug_config = {
      \   'command': 'arm-none-eabi-gdb',
      \   'winbar': 0,
      \ }

" Auto-close termdebug's program-I/O pane.
function! s:CloseTermdebugProgramWin() abort
  for winid in range(1, winnr('$'))
    let bufname = bufname(winbufnr(winid))
    if bufname =~? 'gdb.*program\|debugged-program'
      execute winid . 'close!'
      return
    endif
  endfor
endfunction
autocmd User TermdebugStartPost call s:CloseTermdebugProgramWin()

" =============================================================================
" LSP servers
" =============================================================================
" clangd for C / C++
autocmd User LspSetup call LspAddServer([#{
      \   name: 'clangd',
      \   filetype: ['c', 'cpp'],
      \   path: 'clangd',
      \   args: ['--background-index',
      \          '--header-insertion=never',
      \          '--clang-tidy',
      \          '--completion-style=detailed',
      \          '--pch-storage=memory',
      \          '--query-driver=**/arm-none-eabi-gcc,**/tiarmclang'],
      \ }])

" pyright for Python. Use the nix-profile binary explicitly: a devshell may put
" an older pyright first on PATH, and 1.1.399 emits no diagnostics to a client
" that advertises workspaceFolders support (which this LSP client does).
autocmd User LspSetup call LspAddServer([#{
      \   name: 'pyright',
      \   filetype: ['python'],
      \   path: expand('~/.nix-profile/bin/pyright-langserver'),
      \   args: ['--stdio'],
      \ }])

" asm-lsp for assembly (.s/.S) — clangd does not index asm, so gd/gr/K work in
" .S files via this server instead. Label navigation is architecture-agnostic;
" for instruction hover on ARM add a .asm-lsp.toml at the project root.
autocmd User LspSetup call LspAddServer([#{
      \   name: 'asm-lsp',
      \   filetype: ['asm', 'gas'],
      \   path: expand('~/.nix-profile/bin/asm-lsp'),
      \   args: [],
      \ }])

" autoHighlightDiags must stay on: with it off the plugin drops diagnostics
" entirely. Inline highlighting is suppressed via highlightDiagInline below.
autocmd User LspSetup call LspOptionsSet(#{
      \   autoComplete: v:true,
      \   autoHighlightDiags: v:true,
      \   showDiagInPopup: v:true,
      \   showDiagInBalloon: v:false,
      \   showDiagWithSign: v:true,
      \   showDiagWithVirtualText: v:false,
      \   highlightDiagInline: v:false,
      \   diagSignErrorText: 'E ',
      \   diagSignWarningText: 'W ',
      \   diagSignInfoText: 'I ',
      \   diagSignHintText: 'H ',
      \ })

" Navigation
nnoremap <silent> gd :LspGotoDefinition<CR>
nnoremap <silent> gr :LspShowReferences<CR>
nnoremap <silent> gy :LspGotoTypeDef<CR>
nnoremap <silent> gi :LspGotoImpl<CR>
nnoremap <silent> K  :LspHover<CR>

" ctags (universal-ctags): a whole-tree index of C *and* assembly labels, the
" reliable way to jump across .S files (asm-lsp handles the current file; tags
" span the project). Search up-tree for a tags file. Built-in <C-]> jumps to a
" definition, g<C-]> lists choices; <leader>t fuzzy-searches all tags via fzf;
" :MkTags (re)builds the index in the cwd.
set tags=./tags;,tags
nnoremap <silent> <leader>t :Tags<CR>

" :MkTags builds the index in the cwd. If a compile_commands.json is present it
" scopes tags to the translation units actually compiled (so a symbol like
" board_init_f resolves to the few real definitions in *this* build instead of
" every board's copy) while still indexing all headers (they aren't in the DB).
" Otherwise it falls back to a full recursive index.
command! MkTags call s:MkTags()
function! s:MkTags() abort
  if filereadable('compile_commands.json') && executable('jq')
    call system("{ jq -r '.[].file' compile_commands.json; "
          \ .. "find . \\( -name '*.h' -o -name '*.hpp' \\) -print; } "
          \ .. "| sort -u | ctags -L - --fields=+n")
    echom 'MkTags: scoped to compile_commands.json (+ headers)'
  else
    call system('ctags -R --languages=C,C++,Asm --fields=+n .')
    echom 'MkTags: full tree'
  endif
endfunction

" In assembly, make gd resolve cross-file: asm-lsp only sees the current file,
" while most targets (and macro-defined entry points like ENTRY(_main)) live
" elsewhere and are covered by the tags index. Prefer a tag match, else the LSP.
function! s:AsmGotoDef() abort
  let l:word = expand('<cword>')
  if !empty(taglist('^' . l:word . '$'))
    execute 'tjump ' . l:word
  else
    LspGotoDefinition
  endif
endfunction
autocmd FileType asm,gas nnoremap <buffer> <silent> gd :call <SID>AsmGotoDef()<CR>

" Diagnostics
nnoremap <silent> [d :LspDiagPrev<CR>
nnoremap <silent> ]d :LspDiagNext<CR>
nnoremap <silent> <leader>e :LspDiagShow<CR>

" Symbol search
nnoremap <silent> <leader>s :LspDocumentSymbol<CR>
nnoremap <leader>S :call <SID>LspWorkspaceSymbolFzf(input('Symbol> '))<CR>

" Workspace symbol search via LSP, results piped into fzf for fuzzy filtering.
" Uses the synchronous workspace/symbol RPC and renders matches in an fzf popup.
function! s:LspWorkspaceSymbolFzf(query) abort
  let l:server = lsp#lsp#Server()
  if empty(l:server) || !get(l:server, 'isWorkspaceSymbolProvider', v:false)
    echohl WarningMsg | echo 'LSP: workspace symbol search unavailable' | echohl None
    return
  endif

  let l:reply = l:server.rpc('workspace/symbol', {'query': a:query}, {'handleError': v:false})
  if empty(l:reply) || !has_key(l:reply, 'result') || empty(l:reply.result)
    echohl WarningMsg | echo 'LSP: no symbols match "' . a:query . '"' | echohl None
    return
  endif

  let l:lines = []
  for l:sym in l:reply.result
    if !has_key(l:sym, 'location') || !has_key(l:sym.location, 'range')
      continue
    endif
    let l:path = substitute(l:sym.location.uri, '^file://', '', '')
    let l:lnum = l:sym.location.range.start.line + 1
    let l:col  = l:sym.location.range.start.character + 1
    let l:name = get(l:sym, 'name', '')
    let l:cont = get(l:sym, 'containerName', '')
    let l:disp = empty(l:cont) ? l:name : l:cont . '::' . l:name
    let l:rel  = fnamemodify(l:path, ':.')
    call add(l:lines, printf("%s:%d:%d\t%s\t%s", l:path, l:lnum, l:col, l:disp, l:rel))
  endfor

  if empty(l:lines)
    echohl WarningMsg | echo 'LSP: no usable symbol locations' | echohl None
    return
  endif

  call fzf#run(fzf#wrap('lsp-symbols', {
        \ 'source':  l:lines,
        \ 'sink':    function('s:LspWorkspaceSymbolSink'),
        \ 'options': ['--prompt', 'Symbol> ',
        \             '--delimiter', "\t",
        \             '--with-nth', '2,3',
        \             '--nth', '2,3'],
        \ }))
endfunction

function! s:LspWorkspaceSymbolSink(line) abort
  let l:parts = split(a:line, "\t")
  if empty(l:parts)
    return
  endif
  let l:loc = split(l:parts[0], ':')
  if len(l:loc) < 3
    return
  endif
  let l:col  = str2nr(l:loc[-1])
  let l:lnum = str2nr(l:loc[-2])
  let l:path = join(l:loc[0:-3], ':')
  execute 'edit' fnameescape(l:path)
  call cursor(l:lnum, l:col)
endfunction

